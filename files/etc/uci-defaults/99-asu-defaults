#firstboot -y >/dev/null 2>&1
uci del dhcp.wan
uci del dhcp.lan.ra
uci del dhcp.lan.ra_slaac
uci del dhcp.lan.ra_flags
uci set dhcp.lan.ignore='1'
uci del network.lan.ip6assign
uci del dhcp.lan.dhcpv6
uci del dhcp.odhcpd

exec >/tmp/setup.log 2>&1

for i in firewall dnsmasq odhcpd; do
  if /etc/init.d/"$i" enabled; then
    /etc/init.d/"$i" disable
    /etc/init.d/"$i" stop
  fi
done

service odhcpd disable
service log disable
service firewall disable

uci delete network.wan
uci delete network.wan6
uci delete network.lan
uci delete network.br-lan
uci delete network.br-wan
uci delete network.switch0
uci delete network.switch_vlan
# حذف أي أقسام switch_vlan أخرى إن وجدت
for i in $(uci show network | grep switch_vlan | cut -d'.' -f2 | cut -d'=' -f1); do
  uci delete network.$i
done

# --- 1. Switch & Network Configuration (swconfig for OpenWrt 25) ---

# Enable switch0 and VLAN functionality
uci set network.switch0=switch
uci set network.switch0.name='switch0'
uci set network.switch0.enable_vlan='1'

# Remove all existing switch_vlan sections to prevent duplication/errors
while uci -q delete network.@switch_vlan[0]; do :; done

# Configure VLAN ID 1: CPU (eth0) tagged, LAN untagged, WAN off
uci add network switch_vlan
uci set network.@switch_vlan[-1].device='switch0'
uci set network.@switch_vlan[-1].vlan='2'
uci set network.@switch_vlan[-1].ports='0t 1'

# Configure VLAN ID 2: CPU (eth0) tagged, LAN off, WAN untagged
uci add network switch_vlan
uci set network.@switch_vlan[-1].device='switch0'
uci set network.@switch_vlan[-1].vlan='1'
uci set network.@switch_vlan[-1].ports='0t 2'

# Remove all old device definitions (bridges/interfaces) completely
while uci -q delete network.@device[0]; do :; done

# Create bridge br-lan with device eth0.1
uci add network device
uci set network.@device[-1].name='br-lan'
uci set network.@device[-1].type='bridge'
uci add_list network.@device[-1].ports='eth0.1'

# Create bridge br-wan with device eth0.2
uci add network device
uci set network.@device[-1].name='br-wan'
uci set network.@device[-1].type='bridge'
uci add_list network.@device[-1].ports='eth0.2'

# Configure LAN Interface
uci set network.lan=interface
uci set network.lan.device='br-lan'
uci set network.lan.proto='static'
uci set network.lan.ipaddr='192.168.101.100'
uci set network.lan.netmask='255.255.255.0'
uci set network.lan.gateway='192.168.101.1'
uci set network.lan.delegate='0'

# Configure WAN Interface
uci set network.wan=interface
uci set network.wan.device='br-wan'
uci set network.wan.proto='static'
uci set network.wan.ipaddr='10.10.5.100'
uci set network.wan.netmask='255.255.255.0'
uci set network.wan.gateway='10.10.5.1'

# --- 2. DHCP & Services Configuration ---
uci set dhcp.lan.ignore='1'
uci -q del dhcp.wan
uci -q del dhcp.lan.ra
uci -q del dhcp.lan.ra_slaac
uci -q del dhcp.lan.ra_flags
uci -q del dhcp.odhcpd

# Disable unwanted services safely
for i in firewall dnsmasq odhcpd log; do
  if /etc/init.d/"$i" enabled 2>/dev/null; then
    /etc/init.d/"$i" disable
    /etc/init.d/"$i" stop
  fi
done

# --- 3. Wireless Configuration ---
# Remove existing wireless interfaces safely
for j in $(seq 0 4); do uci -q delete wireless.@wifi-iface[0]; done

# Configure Radio 0 (Mesh & STA)
uci del wireless.radio0.disabled 2>/dev/null
uci set wireless.radio0.beacon_int='200'
uci set wireless.radio0.country='US'
uci set wireless.radio0.htmode='HT20'
uci set wireless.radio0.channel='165'
uci set wireless.radio0.txpower='28'
uci set wireless.radio0.cell_density='2'

# Wifinet0: Mesh (WPA3 SAE)
uci set wireless.wifinet0=wifi-iface
uci set wireless.wifinet0.device='radio0'
uci set wireless.wifinet0.mode='mesh'
uci set wireless.wifinet0.encryption='none'
uci set wireless.wifinet0.mesh_id='Internet-Trunk'
uci set wireless.wifinet0.mesh_fwding='1'
uci set wireless.wifinet0.mesh_rssi_threshold='0'
uci set wireless.wifinet0.disassoc_low_ack='0'
uci set wireless.wifinet0.network='wan'

# Wifinet1: STA (WPA3 SAE)
uci set wireless.wifinet1=wifi-iface
uci set wireless.wifinet1.device='radio0'
uci set wireless.wifinet1.mode='mesh'
uci set wireless.wifinet1.encryption='none'
uci set wireless.wifinet1.mesh_id='Hotspot-Network'
uci set wireless.wifinet1.mesh_fwding='1'
uci set wireless.wifinet1.mesh_rssi_threshold='0'
uci set wireless.wifinet1.disassoc_low_ack='0'
uci set wireless.wifinet1.network='lan'

# Configure Radio 1 (AP)
uci del wireless.radio1.disabled 2>/dev/null
uci set wireless.radio1.beacon_int='200'
uci set wireless.radio1.noscan='1'
uci set wireless.radio1.country='US'
uci set wireless.radio1.htmode='HT20'
uci set wireless.radio1.channel='6'
uci set wireless.radio1.cell_density='0'
uci set wireless.radio1.txpower='27'

# Wifinet2: AP (WPA3 SAE)
uci set wireless.wifinet2=wifi-iface
uci set wireless.wifinet2.device='radio1'
uci set wireless.wifinet2.mode='ap'
uci set wireless.wifinet2.ssid='ENA-100'
uci set wireless.wifinet2.encryption='sae'
uci set wireless.wifinet2.key='Salah_734'
uci set wireless.wifinet2.disassoc_low_ack='0'
uci set wireless.wifinet2.network='lan'
uci set wireless.wifinet2.isolate='1'
uci set wireless.wifinet2.wds='1'

# --- 4. System & Hostname Configuration ---
uci set system.@system[0].hostname='ENAN-SENDER'
uci set system.@system[0].notes='Haddad Inc - Developed by Eng. Salah'
uci set system.@system[0].zonename='Asia/Aden'
uci set system.@system[0].timezone='<+03>-3'
uci set system.@system[0].log_proto='udp'
uci set system.@system[0].conloglevel='8'
uci set system.@system.cronloglevel='5' 2>/dev/null || uci set system.@system[0].cronloglevel='5'

uci -q del system.ntp.enabled
uci -q del system.ntp.enable_server

# --- 5. Firewall & Security Configuration ---
if [ -f /etc/config/firewall ]; then
    mv /etc/config/firewall /etc/config/firewall.unused
fi
echo "Removing root password..."
passwd -d root
# Secure Dropbear SSH
uci set dropbear.@dropbear[0].PasswordAuth='0'
uci set dropbear.@dropbear[0].RootPasswordAuth='0'

# --- 6. Customization & Branding ---
if [ -f /www/luci-static/resources/view/status/include/10_system.js ]; then
    sed -i "s/boardinfo\.model/\'COMFAST\ CF\ WA350\ DEVLOPED-BY\ HADDAD-INC\'/g" /www/luci-static/resources/view/status/include/10_system.js
fi
if [ -f /www/luci-static/resources/view/status/include/10_system.js ]; then
    sed -i "s/_('Firmware Version'),.*/_('Firmware Version'), 'Haddad-Inc / ' + (L.isObject(boardinfo.release) ? boardinfo.release.description + ' \/ ' : '') + (luciversion || ''),/g" /www/luci-static/resources/view/status/include/10_system.js
fi
# تعديل ملف إصدار النظام ليظهر بالشكل المخصص في الشبكة والمايكروتك
if [ -f /etc/openwrt_release ]; then
    sed -i "s/DISTRIB_DESCRIPTION=.*/DISTRIB_DESCRIPTION='Haddad-Inc @ OpenWrt'/g" /etc/openwrt_release
fi

if [ -f /etc/os-release ]; then
    sed -i "s/PRETTY_NAME=.*/PRETTY_NAME='Haddad-Inc @ OpenWrt'/g" /etc/os-release
fi
FOOTER="/usr/share/ucode/luci/template/themes/bootstrap/footer.ut"

if [ -f "$FOOTER" ]; then
    sed -i '/{% endif %}/a \                <span style="margin-left:8px;color:var(--primary);"> ✦ <a href="https:\/\/www.facebook.com\/eng.salah.alhaddad\/" target="_blank" rel="noreferrer" style="color:var(--primary);text-decoration:none;font-weight:bold;">Modified by Eng Salah / Haddad-Inc</a></span>' "$FOOTER"
fi
# Commit all changes
uci commit

echo "All done! Enan Net Switch, Bridge & IP Settings Applied for OpenWrt 25."


